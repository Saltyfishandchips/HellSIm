{"inkVersion":21,"root":[[["ev",{"VAR?":"choice"},1,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_1"},{"->":"0.11"},null]}],["ev",{"VAR?":"choice"},2,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_2"},{"->":"0.11"},null]}],["ev",{"VAR?":"choice"},3,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_3"},{"->":"0.11"},null]}],["ev",{"VAR?":"choice"},4,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_4"},{"->":"0.11"},null]}],["ev",{"VAR?":"choice"},5,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_5"},{"->":"0.11"},null]}],["ev",{"VAR?":"choice"},6,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_6"},{"->":"0.11"},null]}],["ev",{"VAR?":"choice"},7,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_7"},{"->":"0.11"},null]}],["ev",{"VAR?":"choice"},8,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_8"},{"->":"0.11"},null]}],["ev",{"VAR?":"choice"},9,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_9"},{"->":"0.11"},null]}],["ev",{"VAR?":"choice"},10,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_10"},{"->":"0.11"},null]}],["ev",{"VAR?":"choice"},11,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_11"},{"->":"0.11"},null]}],"nop","\n",["done",{"#f":5,"#n":"g-0"}],null],"done",{"choice_1":["^你本名不叫关三柱？ ","#","^Layout:Right","/#","\n","^果然什么事都瞒不过判官老爷。俺不是有意隐瞒的，只是叫三柱习惯了。","#","^Layout:Left","/#","\n","^实话讲了，当年打仗<color=red>俺当了逃兵</color>，老爷收留了我，并把这事帮我瞒过去了。从此以后俺就以关三柱这名活了，现在死了也得叫这名。","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_2":["^没错啊，俺是个大老爷们儿啊，咋了？ ","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_3":["^俺应生在正月十七啊。 ","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_4":["^俺死的那晚该是中秋节，哎…… ","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_5":["^俺记得雷州也是东区吧。","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_6":["^此人阳间常用名为关三柱，其余路引信息审查无误。","#","^Layout:Right","/#","\n","end",{"#f":1}],"choice_7":["^老爷给起的，死了也得叫这名。 ","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_8":["^俺是个大老爷们儿，当兵本应是俺的责任，但战场实在太…… ","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_9":["^俺生在正月十七，正好赶上天寒地冻，那时候家里穷，连炭火都没得烧。","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_10":["^中秋节啊，真希望老爷也去看看集上的灯会。","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_11":["^俺也是雷州人，打仗时被征去北边了几年。俺回来后，便一直待在老爷府上。","#","^Layout:Left","/#","\n","end","end",{"#f":1}],"global decl":["ev",0,{"VAR=":"choice"},"/ev","end",null],"#f":1}],"listDefs":{}}