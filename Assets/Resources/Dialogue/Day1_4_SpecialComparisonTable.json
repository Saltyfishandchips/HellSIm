{"inkVersion":21,"root":[[["ev",{"VAR?":"choice"},1,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_1"},{"->":"0.8"},null]}],["ev",{"VAR?":"choice"},2,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_2"},{"->":"0.8"},null]}],["ev",{"VAR?":"choice"},3,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_3"},{"->":"0.8"},null]}],["ev",{"VAR?":"choice"},4,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_4"},{"->":"0.8"},null]}],["ev",{"VAR?":"choice"},5,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_5"},{"->":"0.8"},null]}],["ev",{"VAR?":"choice"},6,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_6"},{"->":"0.8"},null]}],["ev",{"VAR?":"choice"},7,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_7"},{"->":"0.8"},null]}],["ev",{"VAR?":"choice"},8,"==","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"choice_8"},{"->":"0.8"},null]}],"nop","\n",["done",{"#f":5,"#n":"g-0"}],null],"done",{"choice_1":["^这些是村里的乡亲张贴的启事！","#","^Layout:Left","/#","\n","^我一开始以为是薛怀逸那狗官不管我们的死活，没想到就是<color=red>他掳走了这些村民，真是贼喊捉贼！</color>","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_2":["^这个匾？对了，我听村里的老人提过，是<color=red>三十多年前我们村送给薛进知县的</color>。","#","^Layout:Left ","/#","#","^CE:ED_5","/#","\n","^那时候我们村还算富裕，可近十年才开始衰落——想想不就是薛怀逸这狗官上任以来吗？ ","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_3":["^关三柱就是拿的这把刀杀的我，上面还有我的血，真有点恍如隔世了。","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_4":["^这些废料好像堆在花房角落，当时没注意到这些。","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_5":["^之前去官府时从没见过这个袋子，后来每次去偷药，只顾着药了，也没细想别的。","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_6":["^就是这花！！！我不想再看见它了。","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_7":["^啊啊啊！一切祸事的起源！要是当初没去偷它就好了！不过我没见过这个瓶子，这难道是<color=red>薛怀逸藏在匾额后面的那瓶？</color>","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_8":["^药方？怎么<color=red>主料只有那红花</color>……薛怀逸到底想用它干什么？","#","^Layout:Left ","/#","#","^CE:ED_15","/#","\n","end","end",{"#f":1}],"global decl":["ev",0,{"VAR=":"choice"},"/ev","end",null],"#f":1}],"listDefs":{}}