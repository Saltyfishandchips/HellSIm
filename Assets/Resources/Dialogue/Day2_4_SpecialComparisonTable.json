","/#","\n","end",{"#f":1}],"choice_9":["^谁知他这样薄情寡义，要把月铃往死路上逼！","#","^Layout:Left ","/#","#","^Layout:Left ","/#","#","^CE:ED_16","/#","\n","end","end",{"#f":1}],"global decl":["ev",0,{"VAR=":"choice"},"/ev","end",null],"#f":1}],"listDefs":{}}