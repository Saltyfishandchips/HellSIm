choice_9":["^是呢，这正是蔓露的诞生之年。","#","^Layout:Left","/#","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_10":["^“寒风摧树木，严霜结庭兰”……再难忘、再不舍的时光也终有凋零之日……","#","^Layout:Left","/#","\n","end",{"#f":1}],"choice_11":["^我是南京江宁县人，小时候邻家阿婶阿叔常夸我声音美，我便早早出来打拼了。","#","^Layout:Left","/#","\n","end","end",{"#f":1}],"global decl":["ev",0,{"VAR=":"choice"},"/ev","end",null],"#f":1}],"listDefs":{}}