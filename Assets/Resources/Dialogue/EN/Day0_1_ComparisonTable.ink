// 这是对照表差异项的反馈
VAR choice = 0

    {
        -choice == 1:  
            -> choice_1  
        -choice == 2:  
            -> choice_2 
        -choice == 3:  
            -> choice_3  
        -choice == 4:  
            -> choice_4 
        -choice == 5:  
            -> choice_5
        -choice == 6:  
            -> choice_6
        -choice == 7:  
            -> choice_7
        -choice == 8:  
            -> choice_8
        -choice == 9:  
            -> choice_9
        -choice == 10:  
            -> choice_10
        -choice == 11:  
            -> choice_11

    }  
  
== choice_1
    // 是否提交路引
    Fan Wuchu, found a mistake. Please go on, Lord Arbiter.  #Layout:Left
    ->END
  
== choice_2
    // 姓名是否一致
    Male……Lord Arbiter, the information is correct, please check again. #Layout:Left
    ->END

== choice_3
    // 性别是否一致
    The birthday is not correct. Lord Arbiter, please check it correctly.#Layout:Left
    ->END

== choice_4
    // 生辰八字是否一致
    This is incorrect, Lord Arbiter, please check again.  #Layout:Left
    ->END

== choice_5
    // 死期是否一致
    It is the East District, Lord Arbiter, please check again. #Layout:Left
    ->END
    
== choice_6
    // 路引信息有误
  The pre-trial investigation is completed. I wrote two places wrong, because the other ghosts are more likely to make mistakes as they are not familiar with it. Lord Arbiter, please check carefully.  #Layout:Left
  But the wrong places might be cause by the ghost's obsessions.#Layout:Left
  My date of death has arrived, Lord Arbiter, please sentence me as 'Return to the Netherworld'.#Layout:Left
    ->END

== choice_7
    It is Fan Wujiu, Lord Arbiter, please check again. #Layout:Left
    ->END
    
== choice_8
    Male, that's right. Lord Arbiter, you are sharp. #Layout:Left
    ->END
    
== choice_9
    It should be March the ninth, year six hundred and fifty nine. Please check again. #Layout:Left
    ->END
    
== choice_10
    June the third, year six hundred and eighty six. The time of the rain. #Layout:Left
    ->END
    
== choice_11
    East District, that's right. #Layout:Left
    ->END