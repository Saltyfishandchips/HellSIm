// 这是审判完成的部分
VAR choice = 0

    {
        -choice == 1:  
            -> choice_1  
        -choice == 2:  
            -> choice_2 
        -choice == 3:
            -> choice_3
        -choice == 4:
            -> choice_4      
    }  
  
== choice_1
    // 奖励
    ... Charcoal, fifty-two jin, asphalt, twenty-two and a half jin, lacquer, twenty-two and a half jin... Wait, something seems off... #Layout:Left
    ->END
  
== choice_2
    // 惩罚
    ... Charcoal, fifty-two jin, asphalt, twenty-two and a half jin, lacquer, twenty-two and a half jin... Wait, something seems off... #Layout:Left
    ->END

== choice_3
    // 短暂反阳
   Thank you my lord!#Layout:Left
    ->END

== choice_4
    // 没奖没赏
    ... Charcoal, fifty-two jin, asphalt, twenty-two and a half jin, lacquer, twenty-two and a half jin... Wait, something seems off... #Layout:Left
    ->END
    
->END